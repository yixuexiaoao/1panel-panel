# 复制为 .env 后修改。docker compose 会自动读取同目录的 .env

# 管理员账号。ADMIN_PASSWORD 留空时首次启动会生成随机密码并打印到容器日志
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-a-long-random-string

# 用于加密保存各面板 API Key 的主密钥。留空则自动生成并存到 /data/secret.key
# 一旦设置不要更改，否则已保存的 API Key 无法解密
SECRET_KEY=

# 对外端口
HOST_PORT=8080

# true 时禁止一切变更操作（升级、容器操作、增删服务器），只能查看
READ_ONLY=false

# 放在 HTTPS 反向代理之后时设为 true
COOKIE_SECURE=false
TRUST_PROXY=false

# 状态轮询间隔（秒），0 为关闭后台轮询
POLL_INTERVAL=60
